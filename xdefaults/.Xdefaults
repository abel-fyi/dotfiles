! XTerm appearance
XTerm*background: #151515
XTerm*foreground: #d5d5d5
XTerm*faceName: Adwaita Mono
XTerm*faceSize: 16

! Terminal behavior
XTerm*loginShell: true
XTerm*termName: xterm-256color
XTerm*locale: false
XTerm*utf8: always
xterm*scrollBar: false
XTerm*alternateScroll: true

! Mouse input and clipboard
XTerm*allowMouseOps: true
XTerm*selectToClipboard: true

! Key bindings
! F11 toggles fullscreen; F12 toggles reverse video.
XTerm.vt100.translations: #override \n\
    Ctrl Shift <Key> C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key> V: insert-selection(CLIPBOARD) \n\
    Ctrl <Key> plus: larger-vt-font() \n\
    Ctrl <Key> minus: smaller-vt-font() \n\
    <Key>F11: fullscreen(toggle) \n\
    <Key>F12: set-reverse-video(toggle) \n\
    Alt <Key>Return: insert()
