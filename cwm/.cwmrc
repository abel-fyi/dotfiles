# Appearance
borderwidth 2
color activeborder "#ffbf00"

# Movement: 10 pixels; Shift moves 10 times as much.
# Applications such as xterm may resize in their own increments.
moveamount 10

# Key bindings: Super for CWM, Alt for applications.
# Deliberately preserved the physical US keyboard positions
# for my Spanish (Spain) PC105 layout.
unbind-key all

# Menus
bind-key 4-minus      menu-window
bind-key C4-minus     menu-cmd
bind-key 4-g          menu-group
bind-key 4-underscore menu-exec

# Windows
bind-key C4-Return    terminal
bind-key 4-Return     window-hide
bind-key C4-x         window-close
bind-key C4-g         window-group
bind-key 4-Tab        window-cycle
bind-key 4S-Tab       window-rcycle
bind-key 4-masculine  window-cycle-inclass
bind-key 4S-masculine window-rcycle-inclass

# Move windows
bind-key 4-h  window-move-left
bind-key 4-j  window-move-down
bind-key 4-k  window-move-up
bind-key 4-l  window-move-right
bind-key 4S-h window-move-left-big
bind-key 4S-j window-move-down-big
bind-key 4S-k window-move-up-big
bind-key 4S-l window-move-right-big

# Resize windows
bind-key C4-h  window-resize-left
bind-key C4-j  window-resize-down
bind-key C4-k  window-resize-up
bind-key C4-l  window-resize-right
bind-key C4S-h window-resize-left-big
bind-key C4S-j window-resize-down-big
bind-key C4S-k window-resize-up-big
bind-key C4S-l window-resize-right-big

# Session
bind-key C4S-r restart
bind-key C4S-q quit

# Notes
# C4-g group feedback: blue adds the focused window; red removes it.
# Current group: xprop -root _NET_CURRENT_DESKTOP

# Patch to list all windows when menu-window opens (requires rebuilding CWM):
# https://www.mail-archive.com/misc%40openbsd.org/msg198400.html
