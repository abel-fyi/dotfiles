# ~/.cwmrc — portable cwm configuration
# Keep stock bindings; add only what's useful. See cwm(1), cwmrc(5).
# Key modifiers: M=Alt, C=Ctrl, S=Shift, 4=Super.

# Terminal -------------------------------------------------------------------
command term xterm                    # Explicit default terminal.

# Appearance -----------------------------------------------------------------
borderwidth 5                         # Window and menu borders, in pixels.
color activeborder "#007000"         # Focused window border.
color menufg       "#007000"         # Menu border and selection highlight.
color menubg       "#000000"         # Menu background.
color font         "#eeeeee"         # Menu text.
color selfont      "#000000"         # Selected menu text.
fontname "monospace:style=Bold:size=15"

# Optional screen-edge gaps (top, bottom, left, right).
# gap 8 8 8 8

# Workspaces (groups) --------------------------------------------------------
sticky yes                            # New windows join the current group.

# Alt+1–9: switch groups; Alt+0: show/hide all groups.
bind-key M-1 group-only-1
bind-key M-2 group-only-2
bind-key M-3 group-only-3
bind-key M-4 group-only-4
bind-key M-5 group-only-5
bind-key M-6 group-only-6
bind-key M-7 group-only-7
bind-key M-8 group-only-8
bind-key M-9 group-only-9
bind-key M-0 group-toggle-all

# Alt+Shift+1–9: send the focused window to a group, without following it.
bind-key MS-1 window-movetogroup-1
bind-key MS-2 window-movetogroup-2
bind-key MS-3 window-movetogroup-3
bind-key MS-4 window-movetogroup-4
bind-key MS-5 window-movetogroup-5
bind-key MS-6 window-movetogroup-6
bind-key MS-7 window-movetogroup-7
bind-key MS-8 window-movetogroup-8
bind-key MS-9 window-movetogroup-9

bind-key M-BackSpace group-last       # Alt+Backspace: previous group.

# Window management ----------------------------------------------------------
moveamount 10                         # Movement/resizing: 10px, or 100px with Shift.
bind-key M-c window-snap-center       # Alt+C: center the focused window.

# Optional one-shot tiling. These rearrange existing windows into a
# master/stack layout once; unlike dwm, no layout is maintained afterward.
bind-key M-v  window-vtile           # Alt+V: master left.
# bind-key MS-v window-htile           # Alt+Shift+V: master top.

# Mouse movement, resizing, and menus use stock cwm bindings.

# Notes / limitations --------------------------------------------------------
# No global modkey setting: changing stock Alt bindings means rebinding them
# individually (or patching cwm / changing X11 key mappings).
# Focus-follows-mouse cannot be disabled through cwmrc.
# menu-window starts empty: Ctrl+A lists all windows; automatic listing needs
# a patch: https://www.mail-archive.com/misc@openbsd.org/msg198400.html
# window-snap-* only moves windows; it cannot resize to half/quarter-screen.
# window-vtile/htile resize multiple windows, but are not persistent layouts.
# New windows cannot be automatically centered through cwmrc; use Alt+C.
# Ctrl+Alt+Backspace may terminate Xorg (returning startx users to the TTY).
# Backspace is not the forward Delete key used by Ctrl+Alt+Delete (lock).
