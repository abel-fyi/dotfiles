# Appearance
borderwidth 2
color activeborder "#ffbf00"

# Movement: 10 pixels; Shift moves 10 times as much.
# Applications such as xterm may resize in their own increments.
moveamount 10

# Linux Key bindings
bind-key CM-Return "xterm"
bind-key F4 "brightnessctl --quiet set 5%-"
bind-key F5 "brightnessctl --quiet set +5%"
bind-key XF86MonBrightnessDown "brightnessctl --quiet set 5%-"
bind-key XF86MonBrightnessUp   "brightnessctl --quiet set +5%"
bind-key XF86AudioLowerVolume  "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
bind-key XF86AudioRaiseVolume  "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"
bind-key XF86AudioMute         "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"

# Use US keyboard positions for default shortcuts, regardless of layout.
physical-defaults yes

# Notes
# CM-g group feedback: blue adds the focused window; red removes it.
# Current group: xprop -root _NET_CURRENT_DESKTOP

# Patch to list all windows when menu-window opens (requires rebuilding CWM):
# https://www.mail-archive.com/misc%40openbsd.org/msg198400.html
